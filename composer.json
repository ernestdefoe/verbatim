{
    "name": "ernestdefoe/verbatim",
    "description": "Verbatim — a quote that knows when it has gone stale. The words never change; the quote says so when the post it came from has been edited since.",
    "type": "flarum-extension",
    "keywords": ["flarum", "quotes", "edits", "provenance"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Verbatim",
            "category": "feature"
        }
    }
}
